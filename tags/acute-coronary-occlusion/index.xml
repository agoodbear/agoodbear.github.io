.d3-red{fill:#dc2626;fill-opacity:.08;stroke:#dc2626;stroke-opacity:.7}
.d3-ln{stroke:currentColor;stroke-opacity:.5;stroke-width:1.5}
.d3-b{font-size:14px;font-weight:700}
.d3-b:not([fill]){fill:currentColor}
